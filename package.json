{
  "name": "campus-wexcx",
  "version": "1.0.0",
  "description": "Campus Mutual Aid Platform - A WeChat mini-program for peer-to-peer assistance services",
  "main": "main.js",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore .",
    "lint:fix": "eslint --ext .js,.vue --ignore-path .gitignore . --fix",
    "format": "prettier --write \"**/*.{js,vue,json,scss,css}\"",
    "format:check": "prettier --check \"**/*.{js,vue,json,scss,css}\""
  },
  "dependencies": {
    "vu-icons": "^1.3.6"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.0",
    "prettier": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/campus-wexcx.git"
  },
  "keywords": [
    "uni-app",
    "vue3",
    "pinia",
    "wechat-miniprogram",
    "campus",
    "mutual-aid"
  ],
  "author": "",
  "license": "MIT"
}
